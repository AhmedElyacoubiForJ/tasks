#!/usr/bin/env bash
set -euo pipefail

###############################################################
# LOCAL-POSTGRES ROOT RUNNER (App-Local PostgreSQl-Local Profil)
# -------------------------------------------------------------
# Kategorien:
#   db   → PostgreSQL Dienststatus
#   app  → Spring Boot (jar | mvn)
#   test → Regressionstests (optional)
#
# Architektur:
#   scripts/local-postgres/db-run-universal.sh
#   scripts/local-postgres/app-run-universal.sh
###############################################################

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

DB_RUNNER="$ROOT_DIR/scripts/local-postgres/db-run-universal.sh"
APP_RUNNER="$ROOT_DIR/scripts/local-postgres/app-run-universal.sh"
TEST_RUNNER="$ROOT_DIR/scripts/regression/new-run"   # optional

###############################################################
# HELP
###############################################################
usage() {
  echo ""
  echo "local-postgres Profile Runner"
  echo ""
  echo "Verwendung:"
  echo "  ./run db status"
  echo "  ./run app jar"
  echo "  ./run app mvn"
  echo "  ./run test regression     (optional)"
  echo ""
  echo "Beispiele:"
  echo "  ./run db status"
  echo "  ./run app jar"
  echo ""
  exit 0
}

###############################################################
# ROUTING
###############################################################
CATEGORY="${1:-}"
ACTION="${2:-}"

case "$CATEGORY" in

  #############################################################
  # DB
  #############################################################
  db)
    case "$ACTION" in
      status)
        "$DB_RUNNER" status
        ;;
      *)
        echo "❌ Unbekanntes DB-Kommando: $ACTION"
        echo "ℹ️  Hilfe: ./run --help"
        exit 1
        ;;
    esac
    ;;

  #############################################################
  # APP
  #############################################################
  app)
    case "$ACTION" in
      jar)
        "$APP_RUNNER" jar
        ;;
      mvn)
        "$APP_RUNNER" mvn
        ;;
      *)
        echo "❌ Unbekanntes APP-Kommando: $ACTION"
        echo "ℹ️  Hilfe: ./run --help"
        exit 1
        ;;
    esac
    ;;

  #############################################################
  # TEST (optional)
  #############################################################
  test)
    case "$ACTION" in
      regression)
        if [[ -f "$TEST_RUNNER" ]]; then
          "$TEST_RUNNER"
        else
          echo "⚠️  Regression Runner nicht vorhanden: $TEST_RUNNER"
        fi
        ;;
      *)
        echo "❌ Unbekanntes TEST-Kommando: $ACTION"
        echo "ℹ️  Hilfe: ./run --help"
        exit 1
        ;;
    esac
    ;;

  #############################################################
  # HELP
  #############################################################
  --help|"")
    usage
    ;;

  #############################################################
  # UNKNOWN
  #############################################################
  *)
    echo "❌ Unbekannte Kategorie: $CATEGORY"
    echo "ℹ️  Hilfe: ./run --help"
    exit 1
    ;;
esac
