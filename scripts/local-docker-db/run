#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# scripts/local-docker-db/run
#
# UNIVERSAL ENTRYPOINT FÜR LOKALE ENTWICKLUNG
# -------------------------------------------
# Dieses Script bündelt alle lokalen Dev-Kommandos:
#
#   ./scripts/local-docker-db/run db <up|down|test>
#   ./scripts/local-docker-db/run app <jar|mvn>
#   ./scripts/local-docker-db/run test regression
#
# DESIGN-GRUNDSÄTZE
# -----------------
# 1) DB-Kommandos laufen immer in WSL (Docker läuft dort stabil).
# 2) App-Kommandos nutzen das universelle Script:
#       → JAR-Modus: überall stabil (WSL, Git Bash, Linux, macOS)
#       → mvn-Modus: unter WSL deaktiviert (technische Limitierung)
#
# WARUM ES EIN PROFIL "local-docker-db" GIBT
# ------------------------------------------
# Dieses Profil ist für Entwickler gedacht, die:
#
#   • KEIN PostgreSQL lokal installieren wollen
#   • KEINE Datenbank auf dem Host-System betreiben möchten
#   • Docker in WSL installiert haben
#   • App + PostgreSQL gemeinsam lokal entwickeln wollen
#
# Dabei gilt:
#   - Die **DB läuft in Docker** (unter WSL).
#   - Die **App läuft NICHT im Container**, sondern direkt:
#         • als JAR (empfohlen, überall stabil)
#         • oder über mvn (nur Git Bash / Windows)
#   - Die App spricht automatisch gegen die Docker‑DB.
#   - Alle DB-Parameter kommen aus .env.local-docker-db.
#
# WARUM mvn UNTER WSL DEAKTIVIERT IST
# -----------------------------------
# mvnw.cmd läuft unter Windows/cmd.exe.
# cmd.exe kann ENV-Variablen aus WSL NICHT zuverlässig übernehmen:
#   - Whitespace wird eingefügt
#   - JDBC-URLs werden zerstört
#   - Ports werden falsch interpretiert
#   - DevTools verliert ENV beim Restart
#
# Ergebnis: kaputte DB-Connections.
#
# Lösung:
#   → mvn NUR unter Git Bash / Windows erlauben
#   → unter WSL → JAR-Modus verwenden
###############################################################################

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

source "$ROOT_DIR/scripts/lib/detect-env.sh"

# Farben laden (Fallback)
if [ -f "$ROOT_DIR/scripts/utils/colors.sh" ]; then
    source "$ROOT_DIR/scripts/utils/colors.sh"
else
    # Standardfarben
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' PURPLE='' NC=''

    # Bold
    BOLD_RED='' BOLD_GREEN='' BOLD_YELLOW='' BOLD_CYAN=''

    # Background
    BG_RED='' BG_GREEN=''
fi

###############################################################################
# Kategorie‑Hilfe als Variablen (einfach & ohne Wiederholung)
###############################################################################
DB_HELP_TEXT="
DB-Kommandos:
  run db up
  run db down [--purge]
  run db test
"

APP_HELP_TEXT="
App-Kommandos:
  run app jar
  run app mvn        (nur Git Bash / Windows)
"

TEST_HELP_TEXT="
Test-Kommandos:
  run test regression
      Führt die vollständige Regression-Test-Suite aus.
      Erkennt automatisch WSL/GitBash/Linux/macOS.
      Wartet auf API-Health-Status und startet dann Maven-Tests.
"

###############################################################################
# Globale Usage
###############################################################################
usage() {
  echo "Usage: ./scripts/local-docker-db/run <db|app|test> <command> [args...]"
  echo -e "${YELLOW}${DB_HELP_TEXT}${NC}"
  echo -e "${YELLOW}${APP_HELP_TEXT}${NC}"
  echo -e "${YELLOW}${TEST_HELP_TEXT}${NC}"
  exit 1
}

###############################################################################
# Kategorie‑spezifische Hilfe
###############################################################################
db_help() {
  echo -e "${YELLOW}${DB_HELP_TEXT}${NC}"
  echo -e "${YELLOW}ℹ️  Vollständige Hilfe:${NC} ./scripts/local-docker-db/run --help"
  exit 0
}

app_help() {
  echo -e "${YELLOW}${APP_HELP_TEXT}${NC}"
  echo -e "${YELLOW}ℹ️  Vollständige Hilfe:${NC} ./scripts/local-docker-db/run --help"
  exit 0
}

test_help() {
  echo -e "${YELLOW}${TEST_HELP_TEXT}${NC}"
  echo -e "${YELLOW}ℹ️  Vollständige Hilfe:${NC} ./scripts/local-docker-db/run --help"
  exit 0
}

###############################################################################
# GLOBAL --help
###############################################################################
if [[ "${1:-}" == "--help" ]]; then
    usage
fi

###############################################################################
# Argumentprüfung (verbessert)
###############################################################################
if [[ $# -lt 2 ]]; then
  case "${1:-}" in
    db|app|test)
      echo -e "${RED}❌ Kein Command für Kategorie: $1${NC}"
      echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run $1 --help"
      ;;
    *)
      echo -e "${RED}❌ Unbekannte Kategorie: ${1:-<none>}${NC}"
      echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run --help"
      ;;
  esac
  exit 1
fi

CATEGORY="$1"
COMMAND="$2"
shift 2

###############################################################################
# Hilfsfunktionen
###############################################################################
convert_to_wsl_path() {
  local win_path="$1"
  echo "$win_path" | sed 's|^/c/|/mnt/c/|; s|^/d/|/mnt/d/|'
}

run_in_wsl() {
  local script_path="$1"
  shift
  local full_path="$ROOT_DIR/$script_path"
  local wsl_path
  wsl_path="$(convert_to_wsl_path "$full_path")"
  wsl bash -c "bash '$wsl_path' $*"
}

###############################################################################
# Routing
###############################################################################

case "$CATEGORY" in

  ###########################################################################
  # DB
  ###########################################################################
  db)

    if [[ "$COMMAND" == "--help" ]]; then
        db_help
    fi

    case "$COMMAND" in
      up)
        if [[ "$IS_WSL" == "true" ]]; then
          bash "$SCRIPT_DIR/db-up.sh" "$@"
        else
          run_in_wsl "scripts/local-docker-db/db-up.sh" "$@"
        fi
        ;;
      down)
        if [[ "$IS_WSL" == "true" ]]; then
          bash "$SCRIPT_DIR/db-down.sh" "$@"
        else
          run_in_wsl "scripts/local-docker-db/db-down.sh" "$@"
        fi
        ;;
      test)
        if [[ "$IS_WSL" == "true" ]]; then
          bash "$SCRIPT_DIR/db-test.sh" "$@"
        else
          run_in_wsl "scripts/local-docker-db/db-test.sh" "$@"
        fi
        ;;
      *)
        echo -e "${RED}❌ Unbekannter Command: $COMMAND (Kategorie: db)${NC}"
        echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run db --help"
        exit 1
        ;;
    esac
    ;;

  ###########################################################################
  # APP
  ###########################################################################
  app)

    if [[ "$COMMAND" == "--help" ]]; then
        app_help
    fi

    case "$COMMAND" in
      jar)
        bash "$SCRIPT_DIR/app-run-universal.sh" jar "$@"
        ;;
      mvn)
        if [[ "$IS_WSL" == "true" ]]; then
          echo "❌ mvn-Modus unter WSL nicht unterstützt."
          exit 1
        fi

        if [[ "$IS_GITBASH" == "true" ]]; then
          bash "$SCRIPT_DIR/app-run-universal.sh" mvn "$@"
        else
          "/mnt/c/Program Files/Git/bin/bash.exe" "$SCRIPT_DIR/app-run-universal.sh" mvn "$@"
        fi
        ;;
      *)
        echo -e "${RED}❌ Unbekannter Command: $COMMAND (Kategorie: app)${NC}"
        echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run app --help"
        exit 1
        ;;
    esac
    ;;

  ###########################################################################
  # TEST
  ###########################################################################
  test)

    if [[ "$COMMAND" == "--help" ]]; then
        test_help
    fi

    case "$COMMAND" in
      regression)
        bash "$ROOT_DIR/scripts/regression/run" "$@"
        ;;
      *)
        echo -e "${RED}❌ Unbekannter Command: $COMMAND (Kategorie: test)${NC}"
        echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run test --help"
        exit 1
        ;;
    esac
    ;;

  ###########################################################################
  # Unbekannte Kategorie
  ###########################################################################
  *)
    echo -e "${RED}❌ Unbekannte Kategorie: $CATEGORY${NC}"
    echo -e "${YELLOW}ℹ️  Hilfe:${NC} ./scripts/local-docker-db/run --help"
    exit 1
    ;;
esac