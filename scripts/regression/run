#!/usr/bin/env bash
set -euo pipefail

###############################################################################
# 1. PFADE UND IMPORTS
###############################################################################
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE}")" && pwd)"
ROOT_DIR="$(dirname "$(dirname "$SCRIPT_DIR")")"

if [ -f "$ROOT_DIR/scripts/utils/colors.sh" ]; then
    source "$ROOT_DIR/scripts/utils/colors.sh"
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' NC='' BOLD_YELLOW=''
fi

if [ -f "$ROOT_DIR/scripts/lib/detect-env.sh" ]; then
    source "$ROOT_DIR/scripts/lib/detect-env.sh"
fi

###############################################################################
# 2. KONFIGURATION
###############################################################################
DEFAULT_SUITE="TaskApiFullTestSuite"
VALID_SUITES=("TaskApiFullTestSuite" "TaskListsCrudTestSuite" "TaskListsTasksCrudTestSuite" "TaskListsUseCaseTestSuite")

WAIT_SECONDS=60
SUITE="$DEFAULT_SUITE"
REPORT_NAME="${SUITE}" # Der Report wird nach der Suite benannt

###############################################################################
# 3. HILFSFUNKTIONEN
###############################################################################
center_text() {
  local text="$1"
  local width=$(tput cols 2>/dev/null || echo 80)
  local padding=$(( (width - ${#text}) / 2 ))
  (( padding < 0 )) && padding=0
  printf "%*s%s\n" "$padding" "" "$text"
}

print_usage() {
  echo -e "${YELLOW}Verwendung:${NC} ./scripts/regression/run [--wait <Sekunden>] [--suite <Name>]"
  echo -e "Tipp: Nutze ${CYAN}--help${NC} für die vollständige Liste der Suites."
}

print_help() {
  echo -e "${BOLD_YELLOW}"
  center_text "        REGRESSION TEST RUNNER HELP      "
  echo -e "${NC}"
  print_usage
  echo -e "\n${YELLOW}Verfügbare Suites:${NC}"
  for s in "${VALID_SUITES[@]}"; do echo "  • $s"; done
  echo -e "\n${YELLOW}Beispiele:${NC}"
  echo "  ./scripts/regression/run --wait 15 --suite TaskListsCrudTestSuite"
}

print_header_box() {
  echo -e "${BOLD_YELLOW}"
  center_text "----------------------------------------"
  center_text "      REGRESSION TEST RUNNER START      "
  center_text "----------------------------------------"
  echo -e "${NC}"
}

###############################################################################
# 4. ARGUMENT PARSING
###############################################################################
NEXT_IS_WAIT=false
NEXT_IS_SUITE=false

for arg in "$@"; do
  if [ "$NEXT_IS_WAIT" = true ]; then
    [[ "$arg" =~ ^[0-9]+$ ]] && WAIT_SECONDS="$arg" || { echo "❌ Zahl erwartet"; exit 1; }
    NEXT_IS_WAIT=false; continue
  fi
  if [ "$NEXT_IS_SUITE" = true ]; then
    SUITE="$arg"
    REPORT_NAME="${SUITE}" # Report-Name aktualisieren, falls Suite gewählt wurde
    NEXT_IS_SUITE=false; continue
  fi

  case $arg in
    --help) print_help; exit 0 ;;
    --wait) NEXT_IS_WAIT=true ;;
    --suite) NEXT_IS_SUITE=true ;;
    *) echo -e "${RED}❌ Unbekannt: $arg${NC}"; print_usage; exit 1 ;;
  esac
done

if [[ ! " ${VALID_SUITES[*]} " =~ " ${SUITE} " ]]; then
  echo -e "${RED}❌ Ungültige Suite: ${SUITE}${NC}"; exit 1
fi

###############################################################################
# 5. EXECUTION (MAVEN TESTLAUF)
###############################################################################
echo "🧪 Starte Regression Tests..."
print_header_box

# API-URL Bestimmung
API_URL="http://localhost:8080/actuator/health"
if [[ "${IS_WSL:-false}" == "true" ]]; then
    WIN_IP=$(ip route show | grep default | awk '{print $3}' | head -n 1)
    API_URL="http://$WIN_IP:8080/actuator/health"
fi

echo -e "➡ Ziel-API: ${CYAN}$API_URL${NC}"
echo -e "➡ Test-Suite: ${YELLOW}$SUITE${NC}"

# Health-Check
MAX_RETRIES=$(( WAIT_SECONDS / 2 ))
RETRY_COUNT=0
while ! curl -s --max-time 2 --connect-timeout 2 "$API_URL" | grep -q '"UP"'; do
  RETRY_COUNT=$((RETRY_COUNT + 1))
  printf "."
  [[ "$RETRY_COUNT" -ge "$MAX_RETRIES" ]] && { echo -e "\n${RED}❌ API Timeout${NC}"; exit 1; }
  sleep 2
done

echo -e "\n${GREEN}[ OK ] API bereit. Starte Maven...${NC}"

# Maven Aufruf: Führt Tests aus UND generiert den HTML-Report mit individuellem Namen
if [[ "${IS_WSL:-false}" == "true" ]]; then
    WIN_MVNW=$(wslpath -w "$ROOT_DIR/mvnw.cmd")
    cmd.exe /C "$WIN_MVNW -Dtest=${SUITE} -Pregression test surefire-report:report-only -DoutputName=${REPORT_NAME}"
else
    bash "$ROOT_DIR/mvnw" -Dtest=${SUITE} -Pregression test surefire-report:report-only -DoutputName=${REPORT_NAME}
fi

echo -e "\n${GREEN}✅ Testlauf beendet.${NC}"

###############################################################################
# 6. OPTIONALER REPORT-ÖFFNER
###############################################################################
REPORT_FILE="$ROOT_DIR/target/site/${REPORT_NAME}.html"

#if [ -f "$REPORT_FILE" ]; then
#    echo -e "\n${CYAN}📊 Report generiert: ${YELLOW}${REPORT_NAME}.html${NC}"
#
#    # Kurz warten, um Puffer-Probleme unter WSL zu vermeiden
#    sleep 1
#
#    echo -e "${CYAN}Möchtest du den HTML-Report im Browser öffnen? (y/n)${NC}"
